@model IEnumerable<WebApplication1.Models.SaleItem>

@{
    ViewData["Title"] = "Sale Items";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Sale Items List</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Add Item to Sale</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Item ID</th>
            <th>Sale ID</th>
            <th>Product</th>
            <th>Quantity</th>
            <th>UnitPrice</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.SaleItemID</td>
                    <td>@item.SaleID</td>
                    <td>@item.Product?.Name</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice.ToString("C")</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.SaleItemID" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.SaleItemID" class="btn btn-sm btn-info">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.SaleItemID" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted">No sale items found.</td>
            </tr>
        }
    </tbody>
</table>