@model WebApplication1.Models.SaleItem

@{
    ViewData["Title"] = "Sale Item Details";
}

<h2>Sale Item Details</h2>
<hr />

<div class="card shadow-sm col-md-8">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Sale Item ID</dt>
            <dd class="col-sm-8">@Model.SaleItemID</dd>

            <dt class="col-sm-4">Sale ID</dt>
            <dd class="col-sm-8">@Model.SaleID</dd>

            <dt class="col-sm-4">Product Name</dt>
            <dd class="col-sm-8">@Model.Product?.Name</dd>

            <dt class="col-sm-4">Quantity</dt>
            <dd class="col-sm-8">@Model.Quantity</dd>

            <dt class="col-sm-4">Unit Price</dt>
            <dd class="col-sm-8">@Model.UnitPrice.ToString("C")</dd>
        </dl>
    </div>
</div>

<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model.SaleItemID" class="btn btn-warning"><i class="bi bi-pencil"></i> Edit</a>
    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Back to List</a>
</div>