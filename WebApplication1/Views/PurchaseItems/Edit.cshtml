@model WebApplication1.Models.PurchaseItem

@{
    ViewData["Title"] = "Edit Purchase Item";
}

<h2>Edit Purchase Item</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="PurchaseItemID" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="PurchaseID" class="form-label">Purchase ID</label>
                <select asp-for="PurchaseID" class="form-select" asp-items="ViewBag.PurchaseID"></select>
                <span asp-validation-for="PurchaseID" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ProductID" class="form-label">Product</label>
                <select asp-for="ProductID" class="form-select" asp-items="ViewBag.ProductID"></select>
                <span asp-validation-for="ProductID" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Quantity" class="form-label">Quantity</label>
                <input asp-for="Quantity" type="number" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="UnitCost" class="form-label">Unit Cost</label>
                <input asp-for="UnitCost" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="UnitCost" class="text-danger"></span>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
