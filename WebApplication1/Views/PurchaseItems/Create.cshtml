@model WebApplication1.Models.PurchaseItem

@{
    ViewData["Title"] = "Add Purchase Item";
}

<h2>Add Item to Purchase</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="PurchaseID" class="form-label">Purchase ID</label>
                <select asp-for="PurchaseID" class="form-select" asp-items="ViewBag.PurchaseID">
                    <option value="">-- Select Purchase --</option>
                </select>
                <span asp-validation-for="PurchaseID" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ProductID" class="form-label">Product</label>
                <select asp-for="ProductID" class="form-select" asp-items="ViewBag.ProductID">
                    <option value="">-- Select Product --</option>
                </select>
                <span asp-validation-for="ProductID" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Quantity" class="form-label">Quantity</label>
                <input asp-for="Quantity" type="number" class="form-control" placeholder="1" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="UnitCost" class="form-label">Unit Cost</label>
                <input asp-for="UnitCost" type="number" step="0.01" class="form-control" placeholder="0.00" />
                <span asp-validation-for="UnitCost" class="text-danger"></span>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-success">Save Item</button>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
