@{
    ViewData["Title"] = "AI Inventory Assistant";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm h-100">
        <div class="card-header bg-dark text-white">
            <h4 class="mb-0"><i class="bi bi-robot me-2"></i> AI Inventory Assistant</h4>
        </div>
        <div class="card-body">
            <!-- مساحة عرض الرسائل -->
            <div id="chatBox" class="chat-messages mb-3" style="height: 60vh; overflow-y: auto; border: 1px solid #ccc; padding: 15px; border-radius: 5px;">
                <p class="text-muted">Ask me anything about your inventory...</p>
            </div>
        </div>
        <div class="card-footer">
            <!-- فورم الإدخال -->
            <div class="input-group">
                <input type="text" id="userInput" class="form-control" placeholder="Ask AI..." />
                <button id="sendBtn" class="btn btn-primary" type="button">Send</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('sendBtn').addEventListener('click', async function () {
            const input = document.getElementById('userInput');
            const message = input.value.trim();
            if (!message) return;

            // إضافة رسالة المستخدم للشاشة
            const chatBox = document.getElementById('chatBox');
            chatBox.innerHTML += `<div class="text-end mb-2"><span class="bg-primary text-white p-2 rounded">${message}</span></div>`;
            input.value = '';

            try {
                // لاحظ هنا التعديل المهم في المسار: AiAssistant بدلاً من Home
                const response = await fetch('/AiAssistant/AskAiAssistant', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(message)
                });

                if (response.ok) {
                    const data = await response.json();
                    // إضافة رسالة الذكاء الاصطناعي للشاشة
                    chatBox.innerHTML += `<div class="text-start mb-2"><span class="bg-light text-dark p-2 rounded border">${data.reply}</span></div>`;
                } else {
                    chatBox.innerHTML += `<div class="text-danger">Error processing request.</div>`;
                }
            } catch (error) {
                console.error('Error:', error);
            }

            // النزول لأسفل الشات تلقائياً
            chatBox.scrollTop = chatBox.scrollHeight;
        });
    </script>
}