@model IEnumerable<WebApplication1.Models.SupplierProduct>

@{
    ViewData["Title"] = "Supplier Contracts";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Supplier Contracts</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Add New Contract</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Supplier</th>
            <th>Product</th>
            <th>Contract Price</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Supplier?.SupplierName</td>
                    <td>@item.Product?.Name</td>
                    <td>@item.ContractPrice.ToString("C")</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center text-muted">No contracts found.</td>
            </tr>
        }
    </tbody>
</table>