@model WebApplication1.Models.Purchase

@{
    ViewData["Title"] = "Purchase Details";
}

<h2>Purchase Details</h2>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-3">Purchase ID</dt>
        <dd class="col-sm-9">@Model.PurchaseID</dd>

        <dt class="col-sm-3">Supplier Name</dt>
        <dd class="col-sm-9">@(Model.Supplier?.SupplierName ?? "N/A")</dd>

        <dt class="col-sm-3">Supplier Contact</dt>
        <dd class="col-sm-9">@(Model.Supplier?.ContactName ?? "N/A") - @(Model.Supplier?.Phone ?? "")</dd>

        <dt class="col-sm-3">Purchase Date</dt>
        <dd class="col-sm-9">@Model.PurchaseDate.ToString("yyyy-MM-dd HH:mm")</dd>

        <dt class="col-sm-3">Total Amount</dt>
        <dd class="col-sm-9">@Model.TotalAmount.ToString("C")</dd>
    </dl>
</div>

<h4 class="mt-4">Purchase Items</h4>
<table class="table table-bordered table-striped mt-2">
    <thead class="table-dark">
        <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Unit Cost</th>
            <th>Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.PurchaseItems != null && Model.PurchaseItems.Any())
        {
            foreach (var item in Model.PurchaseItems)
            {
                <tr>
                    <td>@(item.Product?.Name ?? $"Product #{item.ProductID}")</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitCost.ToString("C")</td>
                    <td>@((item.Quantity * item.UnitCost).ToString("C"))</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center text-muted fw-bold">No items found for this purchase.</td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model.PurchaseID" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>