@model WebApplication1.Models.Sale

@{
    ViewData["Title"] = "Sale Details";
}

<h1 class="mb-4">Sale Details</h1>

<div>
    <h4>Sale Information</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.SaleID</dd>

        <dt class="col-sm-2">Date</dt>
        <dd class="col-sm-10">@Model.SaleDate</dd>

        <dt class="col-sm-2">Total Amount</dt>
        <dd class="col-sm-10">@Model.TotalAmount</dd>
    </dl>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.SaleID" class="btn btn-warning">Edit</a> |
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>