@model WebApplication1.Models.Sale

@{
    ViewData["Title"] = "Sale Details";
}

<h2>Sale Details</h2>
<hr />

<div class="card shadow-sm col-md-8">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Sale ID</dt>
            <dd class="col-sm-8">@Model.SaleID</dd>

            <dt class="col-sm-4">Sale Date</dt>
            <dd class="col-sm-8">@Model.SaleDate.ToString("yyyy-MM-dd HH:mm")</dd>

            <dt class="col-sm-4">Total Amount</dt>
            <dd class="col-sm-8">@Model.TotalAmount.ToString("C")</dd>
        </dl>
    </div>
</div>

<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model.SaleID" class="btn btn-warning"><i class="bi bi-pencil"></i> Edit</a>
    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Back to List</a>
</div>