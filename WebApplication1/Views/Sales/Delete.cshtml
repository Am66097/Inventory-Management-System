@model WebApplication1.Models.Sale

@{
    ViewData["Title"] = "Delete Sale";
}

<h1 class="mb-4 text-danger">Delete Sale</h1>

<h3>Are you sure you want to delete this record?</h3>
<div>
    <h4>Sale Information</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.SaleID</dd>

        <dt class="col-sm-2">Date</dt>
        <dd class="col-sm-10">@Model.SaleDate</dd>

        <dt class="col-sm-2">Total Amount</dt>
        <dd class="col-sm-10">@Model.TotalAmount</dd>
    </dl>

    <form asp-action="Delete" class="mt-4">
        <input type="hidden" asp-for="SaleID" />
        <button type="submit" class="btn btn-danger">Confirm Delete</button> |
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>