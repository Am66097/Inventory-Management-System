@model IEnumerable<WebApplication1.Models.Sale>

@{
    ViewData["Title"] = "Sales List";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Sales List</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Create New Sale</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Sale ID</th>
            <th>Sale Date</th>
            <th>Total Amount</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.SaleID</td>
                    <td>@item.SaleDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@item.TotalAmount.ToString("C")</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.SaleID" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.SaleID" class="btn btn-sm btn-info">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.SaleID" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center text-muted">No sales records found.</td>
            </tr>
        }
    </tbody>
</table>