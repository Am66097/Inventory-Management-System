<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - STOCKORA</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- STOCKORA CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <!-- ==============================
         SIDEBAR
         ============================== -->
    <aside class="sidebar">

        <!-- BRAND -->
        <div class="brand">
            <div class="brand-icon">
                <i class="bi bi-box-seam"></i>
            </div>
            <span>STOCKORA</span>
        </div>

        <!-- ==============================
             OVERVIEW
             ============================== -->
        <div class="sidebar-section">
            <small>OVERVIEW</small>
            <a asp-controller="Home" asp-action="Index" class="sidebar-link">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Dashboard</span>
            </a>
        </div>

        <!-- ==============================
             MANAGEMENT
             ============================== -->
        <div class="sidebar-section">
            <small>MANAGEMENT</small>
            <a asp-controller="Products" asp-action="Index" class="sidebar-link">
                <i class="bi bi-box"></i>
                <span>Products</span>
            </a>
            <a asp-controller="Categories" asp-action="Index" class="sidebar-link">
                <i class="bi bi-tags"></i>
                <span>Categories</span>
            </a>
            <a asp-controller="Suppliers" asp-action="Index" class="sidebar-link">
                <i class="bi bi-truck"></i>
                <span>Suppliers</span>
            </a>
            <a asp-controller="SupplierProducts" asp-action="Index" class="sidebar-link">
                <i class="bi bi-diagram-3"></i>
                <span>Supplier Contracts</span>
            </a>
        </div>

        <!-- ==============================
             OPERATIONS
             ============================== -->
        <div class="sidebar-section">
            <small>OPERATIONS</small>
            <a asp-controller="Purchases" asp-action="Index" class="sidebar-link">
                <i class="bi bi-cart-plus"></i>
                <span>Purchases</span>
            </a>
            <a asp-controller="Sales" asp-action="Index" class="sidebar-link">
                <i class="bi bi-receipt"></i>
                <span>Sales</span>
            </a>
        </div>

        <!-- ==============================
             ANALYTICS
             ============================== -->
        <div class="sidebar-section">
            <small>ANALYTICS</small>
            <a href="#" class="sidebar-link">
                <i class="bi bi-bar-chart-line"></i>
                <span>Analytics</span>
            </a>
            <a href="#" class="sidebar-link">
                <i class="bi bi-file-earmark-bar-graph"></i>
                <span>Reports</span>
            </a>
        </div>

        <!-- ==============================
             AI TOOLS (التعديل الجديد)
             ============================== -->
        <div class="sidebar-section">
            <small>AI TOOLS</small>
            <a asp-controller="AiAssistant" asp-action="Index" class="sidebar-link">
                <i class="bi bi-robot text-info"></i> <!-- أضفت لون مميز للأيقونة -->
                <span>AI Assistant</span>
            </a>
        </div>

        <!-- ==============================
             SIDEBAR BOTTOM
             ============================== -->
        <div class="sidebar-bottom">
            <a href="#" class="sidebar-link">
                <i class="bi bi-gear"></i>
                <span>Settings</span>
            </a>
            <a href="#" class="sidebar-link">
                <i class="bi bi-question-circle"></i>
                <span>Help Center</span>
            </a>

            <!-- SIDEBAR USER -->
            <div class="sidebar-user">
                <div class="sidebar-user-avatar">
                    <i class="bi bi-person"></i>
                </div>
                <div>
                    <strong>Admin</strong>
                    <span>Administrator</span>
                </div>
            </div>
        </div>
    </aside>


    <!-- ==============================
         MAIN WRAPPER
         ============================== -->
    <div class="main-wrapper">

        <!-- ==============================
             TOPBAR
             ============================== -->
        <header class="topbar">

            <!-- LEFT -->
            <div class="topbar-title">
                <span class="topbar-label">
                    INVENTORY SYSTEM
                </span>
                <h6>
                    Inventory Management
                </h6>
                <small>
                    Smart control for your business
                </small>
            </div>

            <!-- RIGHT -->
            <div class="topbar-right">

                <!-- SEARCH -->
                <div class="topbar-search">
                    <i class="bi bi-search"></i>
                    <input type="text" placeholder="Search inventory..." />
                </div>

                <!-- NOTIFICATION -->
                <button type="button" class="topbar-icon">
                    <i class="bi bi-bell"></i>
                    <span class="notification-dot"></span>
                </button>

                <!-- PROFILE -->
                <div class="profile-menu">
                    <div class="profile-image d-flex align-items-center justify-content-center bg-secondary">
                        <i class="bi bi-person-fill text-white fs-4"></i>
                    </div>
                    <div class="profile-info">
                        <strong>Amin</strong>
                        <span>System Admin</span>
                    </div>
                    <i class="bi bi-chevron-down profile-arrow"></i>
                </div>

                <!-- LOGOUT -->
                <a href="#" class="logout-button">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Logout</span>
                </a>
            </div>
        </header>


        <!-- ==============================
             PAGE CONTENT
             ============================== -->
        <main class="content">
            @RenderBody()
        </main>
    </div>

    <!-- ==============================
         BOOTSTRAP JS
         ============================== -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- ==============================
         SITE JS
         ============================== -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- ==============================
         PAGE SCRIPTS
         ============================== -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>