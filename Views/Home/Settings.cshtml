@{
    ViewData["Title"] = "Account Settings";
    string currentAvatar = ViewBag.UserAvatar as string ?? "";
    string currentName = ViewBag.UserName as string ?? "Admin";
    string currentEmail = ViewBag.UserEmail as string ?? "admin@stockora.com";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1" style="color: #f8fafc;">⚙️️ Account & Profile Settings</h2>
        <p class="text-secondary small mb-0">Manage your profile details, avatar, credentials, and email</p>
    </div>
</div>

<!-- رسائل النجاح أو الخطأ -->
@if (TempData["ProfileSuccess"] != null)
{
    <div class="alert alert-dismissible fade show text-white mb-4 d-flex align-items-center justify-content-between"
         style="background: rgba(16, 185, 129, 0.18); border: 1px solid rgba(16, 185, 129, 0.4); border-radius: 14px; backdrop-filter: blur(10px);">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
            <span class="fw-semibold">@TempData["ProfileSuccess"]</span>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ProfileError"] != null)
{
    <div class="alert alert-dismissible fade show text-white mb-4 d-flex align-items-center justify-content-between"
         style="background: rgba(239, 68, 68, 0.18); border: 1px solid rgba(239, 68, 68, 0.4); border-radius: 14px; backdrop-filter: blur(10px);">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-octagon-fill text-danger fs-5"></i>
            <span class="fw-semibold">@TempData["ProfileError"]</span>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="p-4 rounded-4" style="background: #161b26; border: 1px solid rgba(255,255,255,0.08); box-shadow: 0 10px 30px rgba(0,0,0,0.3);">
            <form asp-controller="Home" asp-action="UpdateProfile" method="post" enctype="multipart/form-data">

                <!-- 1. رفع صورة البروفايل -->
                <div class="d-flex align-items-center gap-4 mb-4 pb-4 border-bottom border-secondary border-opacity-25">
                    <div id="avatarPreviewContainer" style="width: 80px; height: 80px; border-radius: 50%; overflow: hidden; background: linear-gradient(135deg, #4f46e5, #6366f1); display: flex; align-items: center; justify-content: center; border: 2px solid rgba(255,255,255,0.2);">
                        @if (!string.IsNullOrEmpty(currentAvatar))
                        {
                            <img id="avatarPreview" src="@currentAvatar" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover;" />
                        }
                        else
                        {
                            <span id="avatarLetter" class="text-white fw-bold fs-2">@currentName[0]</span>
                            <img id="avatarPreview" src="" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover; display: none;" />
                        }
                    </div>
                    <div>
                        <h6 class="text-white fw-bold mb-1">Profile Photo</h6>
                        <p class="text-secondary small mb-2">Upload a modern avatar (JPG, PNG)</p>
                        <label class="btn btn-outline-light btn-sm px-3 rounded-3" style="cursor: pointer;">
                            <i class="bi bi-camera me-1"></i> Choose New Photo
                            <input type="file" name="profileImage" id="profileImageInput" accept="image/*" style="display: none;" onchange="previewImage(event)" />
                        </label>
                    </div>
                </div>

                <!-- 2. الاسم والبريد الإلكتروني -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label text-secondary small fw-semibold">Display / Full Name</label>
                        <input type="text" name="fullName" class="form-control"
                               style="background: #0f131d; border: 1px solid #283042; color: #fff; padding: 10px 14px; border-radius: 12px;"
                               value="@currentName" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-secondary small fw-semibold">Email Address (Gmail)</label>
                        <input type="email" name="email" class="form-control"
                               style="background: #0f131d; border: 1px solid #283042; color: #fff; padding: 10px 14px; border-radius: 12px;"
                               value="@currentEmail" required />
                    </div>
                </div>

                <!-- 3. تغيير كلمة المرور -->
                <h6 class="text-white fw-bold mb-3 pt-2">Security & Password</h6>
                <div class="row g-3 mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                    <div class="col-md-6">
                        <label class="form-label text-secondary small fw-semibold">New Password</label>
                        <input type="password" name="newPassword" class="form-control"
                               style="background: #0f131d; border: 1px solid #283042; color: #fff; padding: 10px 14px; border-radius: 12px;"
                               placeholder="Leave empty to keep current" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-secondary small fw-semibold">Confirm New Password</label>
                        <input type="password" name="confirmPassword" class="form-control"
                               style="background: #0f131d; border: 1px solid #283042; color: #fff; padding: 10px 14px; border-radius: 12px;"
                               placeholder="Confirm new password" />
                    </div>
                </div>

                <!-- زر الحفظ -->
                <button type="submit" class="btn btn-primary px-4 py-2 rounded-3 fw-semibold"
                        style="background: linear-gradient(135deg, #4f46e5, #6366f1); border: none; box-shadow: 0 4px 15px rgba(99,102,241,0.4);">
                    <i class="bi bi-save me-1"></i> Save Profile Changes
                </button>
            </form>
        </div>
    </div>

    <!-- كارت إرشادي جانبي -->
    <div class="col-lg-4">
        <div class="p-4 rounded-4" style="background: #161b26; border: 1px solid rgba(255,255,255,0.08);">
            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="fs-4">🛡️</span>
                <h6 class="fw-bold text-white mb-0">Account Security</h6>
            </div>
            <p class="text-secondary small line-height-lg mb-3">
                Your profile details (Name, Gmail, and Profile Image) are synchronized live across the top navigation bar and sidebar.
            </p>
            <div class="p-3 rounded-3" style="background: rgba(99,102,241,0.1); border: 1px solid rgba(99,102,241,0.25);">
                <small class="text-info">💡 Tip: After saving, your image and new details will update automatically everywhere.</small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previewImage(event) {
            const input = event.target;
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const preview = document.getElementById('avatarPreview');
                    const letter = document.getElementById('avatarLetter');
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                    if (letter) letter.style.display = 'none';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}