@{
    ViewData["Title"] = "Analytics";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1" style="color: #f8fafc;">📊 Performance Analytics</h2>
        <p class="text-secondary small mb-0">Overview of financial health and inventory volume</p>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Financial Flow -->
    <div class="col-md-6">
        <div class="p-4 rounded-4" style="background: #161b26; border: 1px solid rgba(255,255,255,0.08); box-shadow: 0 10px 30px rgba(0,0,0,0.3);">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-white mb-0">Revenue vs Purchases</h5>
                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Financial Flow</span>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between text-secondary small mb-1">
                    <span>Total Sales Revenue</span>
                    <strong class="text-success">$@ViewBag.TotalSales</strong>
                </div>
                <div class="progress" style="height: 8px; background: #0f131d; border-radius: 10px;">
                    <div class="progress-bar bg-success" style="width: 75%; border-radius: 10px;"></div>
                </div>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between text-secondary small mb-1">
                    <span>Total Purchase Expenses</span>
                    <strong class="text-danger">$@ViewBag.TotalPurchases</strong>
                </div>
                <div class="progress" style="height: 8px; background: #0f131d; border-radius: 10px;">
                    <div class="progress-bar bg-danger" style="width: 45%; border-radius: 10px;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Inventory Health -->
    <div class="col-md-6">
        <div class="p-4 rounded-4" style="background: #161b26; border: 1px solid rgba(255,255,255,0.08); box-shadow: 0 10px 30px rgba(0,0,0,0.3);">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-white mb-0">Catalog Distribution</h5>
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1">Active Catalog</span>
            </div>
            <div class="d-flex align-items-center justify-content-between py-2">
                <div>
                    <h3 class="fw-bold text-white mb-0">@ViewBag.ProductsCount</h3>
                    <small class="text-secondary">Total Managed Products</small>
                </div>
                <div style="font-size: 32px;">📦</div>
            </div>
            <div class="mt-3 p-3 rounded-3" style="background: rgba(99,102,241,0.08); border: 1px solid rgba(99,102,241,0.2);">
                <small class="text-info">💡 Insight: Monitor low stock thresholds regularly to maintain healthy margins.</small>
            </div>
        </div>
    </div>
</div>