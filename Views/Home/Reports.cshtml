@model List<WebApplication1.Models.Product>
@{
    ViewData["Title"] = "Reports";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1" style="color: #f8fafc;">📑 Inventory Summary Report</h2>
        <p class="text-secondary small mb-0">Generate and print reports for low-stock products</p>
    </div>
    <button onclick="window.print()" class="btn btn-outline-light px-3 py-2 rounded-3" style="font-size: 14px;">
        <i class="bi bi-printer me-2"></i> Print / Export PDF
    </button>
</div>

<div class="card shadow-sm border-0 rounded-4" style="background-color: #161b26; border: 1px solid rgba(255, 255, 255, 0.08) !important;">
    <div class="card-header bg-transparent d-flex justify-content-between align-items-center py-3" style="border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
        <h5 class="text-danger fw-bold mb-0">⚠️ Critical Low-Stock Audit</h5>
        <span class="text-secondary small">Generated Live</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0" style="background-color: transparent;">
                <thead>
                    <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                        <th class="py-3 px-4 text-secondary">Product Name</th>
                        <th class="py-3 px-4 text-secondary">Stock Quantity</th>
                        <th class="py-3 px-4 text-secondary">Threshold Level</th>
                        <th class="py-3 px-4 text-secondary">Action Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.04);">
                                <td class="py-3 px-4 fw-medium text-white">@item.ProductName</td>
                                <td class="py-3 px-4 text-danger fw-bold">@item.StockQuantity</td>
                                <td class="py-3 px-4 text-secondary">@item.LowStockThreshold</td>
                                <td class="py-3 px-4"><span class="badge bg-danger bg-opacity-15 text-danger px-2 py-1">Restock Urgently</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-success py-5 fw-bold">
                                ✨ No low-stock alerts. All products are well supplied!
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>