@{
    Layout = null;
    ViewData["Title"] = "Create Account - Stockora";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Account - STOCKORA</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                background-color: #0b111e;
                color: #ffffff;
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 20px;
                background: radial-gradient(circle at 50% 20%, rgba(99, 102, 241, 0.15), transparent 45%), #0b111e;
            }

            .auth-container {
                width: 100%;
                max-width: 440px;
            }

            .auth-brand {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                margin-bottom: 24px;
                text-decoration: none;
                color: #ffffff;
                font-size: 24px;
                font-weight: 800;
                letter-spacing: -0.5px;
            }

            .brand-icon {
                width: 42px;
                height: 42px;
                background: linear-gradient(135deg, #4f46e5, #6366f1);
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 22px;
                box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);
            }

            .auth-card {
                background: #161b26;
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 24px;
                padding: 34px 30px;
                box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
            }

            .auth-header {
                text-align: center;
                margin-bottom: 22px;
            }

                .auth-header h2 {
                    font-size: 23px;
                    font-weight: 700;
                    margin-bottom: 6px;
                    color: #ffffff;
                }

                .auth-header p {
                    color: #94a3b8;
                    font-size: 13.5px;
                }

            .form-label {
                font-size: 12.5px;
                font-weight: 600;
                color: #94a3b8;
                margin-bottom: 5px;
            }

            .form-control {
                background: #0f131d;
                border: 1px solid #232b3b;
                color: #ffffff;
                border-radius: 11px;
                padding: 10px 14px;
                font-size: 13.5px;
                transition: all 0.2s ease;
            }

                .form-control:focus {
                    background: #0f131d;
                    border-color: #6366f1;
                    color: #ffffff;
                    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
                }

            .btn-submit {
                background: linear-gradient(135deg, #4f46e5, #6366f1);
                color: #ffffff;
                border: none;
                width: 100%;
                padding: 12px;
                border-radius: 12px;
                font-weight: 600;
                font-size: 14.5px;
                margin-top: 10px;
                box-shadow: 0 8px 24px rgba(79, 70, 229, 0.35);
                transition: all 0.25s ease;
            }

                .btn-submit:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 12px 28px rgba(79, 70, 229, 0.5);
                    color: #ffffff;
                }

            .auth-footer {
                text-align: center;
                margin-top: 20px;
                font-size: 13.5px;
                color: #94a3b8;
            }

                .auth-footer a {
                    color: #818cf8;
                    text-decoration: none;
                    font-weight: 600;
                }

                    .auth-footer a:hover {
                        text-decoration: underline;
                    }
    </style>
</head>
<body>

    <div class="auth-container">
        <!-- Brand -->
        <a asp-controller="Home" asp-action="Index" class="auth-brand">
            <div class="brand-icon">
                <i class="bi bi-box-seam"></i>
            </div>
            <span>STOCKORA</span>
        </a>

        <!-- Card -->
        <div class="auth-card">
            <div class="auth-header">
                <h2>Create Account</h2>
                <p>Register as an administrator to manage warehouse</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2 px-3 rounded-3 small mb-3 border-0 bg-danger bg-opacity-20 text-danger">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @ViewBag.Error
                </div>
            }

            <form asp-action="Register" method="post">
                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input type="text" name="fullName" class="form-control" placeholder="e.g. John Doe" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Email Address</label>
                    <input type="email" name="email" class="form-control" placeholder="admin@stockora.com" required />
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label">Password</label>
                        <input type="password" name="password" class="form-control" placeholder="••••••••" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Confirm Password</label>
                        <input type="password" name="confirmPassword" class="form-control" placeholder="••••••••" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-submit">
                    Create Account <i class="bi bi-check-circle ms-1"></i>
                </button>
            </form>

            <div class="auth-footer">
                Already have an account?
                <a asp-action="Login">Sign In</a>
            </div>
        </div>
    </div>

</body>
</html>