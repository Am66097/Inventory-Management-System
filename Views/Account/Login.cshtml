@{
    Layout = null;
    ViewData["Title"] = "Sign In - Stockora";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In - STOCKORA</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                background-color: #0b111e;
                color: #ffffff;
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 20px;
                background: radial-gradient(circle at 50% 20%, rgba(99, 102, 241, 0.15), transparent 45%), #0b111e;
            }

            .auth-container {
                width: 100%;
                max-width: 420px;
            }

            .auth-brand {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                margin-bottom: 28px;
                text-decoration: none;
                color: #ffffff;
                font-size: 24px;
                font-weight: 800;
                letter-spacing: -0.5px;
            }

            .brand-icon {
                width: 42px;
                height: 42px;
                background: linear-gradient(135deg, #4f46e5, #6366f1);
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 22px;
                box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);
            }

            .auth-card {
                background: #161b26;
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 24px;
                padding: 36px 32px;
                box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
            }

            .auth-header {
                text-align: center;
                margin-bottom: 26px;
            }

                .auth-header h2 {
                    font-size: 24px;
                    font-weight: 700;
                    margin-bottom: 6px;
                    color: #ffffff;
                }

                .auth-header p {
                    color: #94a3b8;
                    font-size: 14px;
                }

            .form-label {
                font-size: 13px;
                font-weight: 600;
                color: #94a3b8;
                margin-bottom: 6px;
            }

            .form-control {
                background: #0f131d;
                border: 1px solid #232b3b;
                color: #ffffff;
                border-radius: 12px;
                padding: 12px 14px;
                font-size: 14px;
                transition: all 0.2s ease;
            }

                .form-control:focus {
                    background: #0f131d;
                    border-color: #6366f1;
                    color: #ffffff;
                    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
                }

            .btn-submit {
                background: linear-gradient(135deg, #4f46e5, #6366f1);
                color: #ffffff;
                border: none;
                width: 100%;
                padding: 13px;
                border-radius: 12px;
                font-weight: 600;
                font-size: 15px;
                margin-top: 10px;
                box-shadow: 0 8px 24px rgba(79, 70, 229, 0.35);
                transition: all 0.25s ease;
            }

                .btn-submit:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 12px 28px rgba(79, 70, 229, 0.5);
                    color: #ffffff;
                }

            .auth-footer {
                text-align: center;
                margin-top: 22px;
                font-size: 14px;
                color: #94a3b8;
            }

                .auth-footer a {
                    color: #818cf8;
                    text-decoration: none;
                    font-weight: 600;
                }

                    .auth-footer a:hover {
                        text-decoration: underline;
                    }
    </style>
</head>
<body>

    <div class="auth-container">
        <!-- Brand -->
        <a asp-controller="Home" asp-action="Index" class="auth-brand">
            <div class="brand-icon">
                <i class="bi bi-box-seam"></i>
            </div>
            <span>STOCKORA</span>
        </a>

        <!-- Card -->
        <div class="auth-card">
            <div class="auth-header">
                <h2>Welcome Back</h2>
                <p>Sign in to access your inventory control</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2 px-3 rounded-3 small mb-3 border-0 bg-danger bg-opacity-20 text-danger">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @ViewBag.Error
                </div>
            }

            <form asp-action="Login" method="post">
                <div class="mb-3">
                    <label class="form-label">Email Address</label>
                    <div class="input-group">
                        <input type="email" name="email" class="form-control" placeholder="admin@stockora.com" required value="admin@stockora.com" />
                    </div>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label mb-0">Password</label>
                        <span class="text-secondary small" style="font-size: 11px;">Default: admin123</span>
                    </div>
                    <input type="password" name="password" class="form-control" placeholder="••••••••" required value="admin123" />
                </div>

                <button type="submit" class="btn btn-submit">
                    Sign In to Dashboard <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </form>

            <div class="auth-footer">
                Don't have an account?
                <a asp-action="Register">Create Account</a>
            </div>
        </div>
    </div>

</body>
</html>