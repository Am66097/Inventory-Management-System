@model IEnumerable<WebApplication1.Models.Product>

@{
    ViewData["Title"] = "Product Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Products</h2>
        <p class="text-muted mb-0">
            Browse and manage your inventory products
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i>
        Add New Product
    </a>
</div>

<!-- Search & Filters -->
<div class="card mb-4">
    <div class="card-body">

        <form asp-action="Index" method="get">

            <div class="row g-3">

                <!-- Search -->
                <div class="col-lg-5">
                    <label class="form-label">
                        Search Products
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               name="searchString"
                               value="@ViewData["CurrentFilter"]"
                               class="form-control"
                               placeholder="Search by name or description..." />

                    </div>
                </div>

                <!-- Category -->
                <div class="col-lg-3">
                    <label class="form-label">
                        Category
                    </label>

                    <select name="categoryId" class="form-select">

                        <option value="">
                            All Categories
                        </option>

                        @foreach (var category in ViewBag.Categories)
                        {
                            <option value="@category.Value"
                                    selected="@(category.Selected ? "selected" : null)">
                                @category.Text
                            </option>
                        }

                    </select>
                </div>

                <!-- Status -->
                <div class="col-lg-3">
                    <label class="form-label">
                        Stock Status
                    </label>

                    <select name="status" class="form-select">

                        <option value="">
                            All Status
                        </option>

                        <option value="InStock"
                                selected="@(ViewData["CurrentStatus"]?.ToString() == "InStock" ? "selected" : null)">
                            In Stock
                        </option>

                        <option value="LowStock"
                                selected="@(ViewData["CurrentStatus"]?.ToString() == "LowStock" ? "selected" : null)">
                            Low Stock
                        </option>

                        <option value="OutOfStock"
                                selected="@(ViewData["CurrentStatus"]?.ToString() == "OutOfStock" ? "selected" : null)">
                            Out of Stock
                        </option>

                    </select>
                </div>

                <!-- Filter Button -->
                <div class="col-lg-1 d-flex align-items-end">

                    <button type="submit"
                            class="btn btn-primary w-100"
                            title="Apply Filters">

                        <i class="bi bi-funnel"></i>

                    </button>

                </div>

            </div>

        </form>

    </div>
</div>


<!-- Products Table -->
<div class="card">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead>
                    <tr>

                        <th>Product</th>

                        <th>Category</th>

                        <th>Price</th>

                        <th>Stock Quantity</th>

                        <th>Status</th>

                        <th class="text-end">
                            Actions
                        </th>

                    </tr>
                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- Product -->
                                <td>

                                    <strong>
                                        @item.ProductName
                                    </strong>

                                    <br />

                                    <small class="text-muted">
                                        SKU: @item.SKU
                                    </small>

                                </td>


                                <!-- Category -->
                                <td>

                                    <span class="badge bg-primary">
                                        @(item.Category?.CategoryName ?? "No Category")
                                    </span>

                                </td>


                                <!-- Price -->
                                <td>

                                    <strong>
                                        @item.UnitPrice.ToString("C")
                                    </strong>

                                </td>


                                <!-- Stock -->
                                <td>

                                    <strong>
                                        @item.StockQuantity
                                    </strong>

                                </td>


                                <!-- Status -->
                                <td>

                                    @if (item.StockQuantity == 0)
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-x-circle"></i>
                                            Out of Stock
                                        </span>
                                    }
                                    else if (item.StockQuantity <= item.LowStockThreshold)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-exclamation-triangle"></i>
                                            Low Stock
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle"></i>
                                            In Stock
                                        </span>
                                    }

                                </td>


                                <!-- Actions -->
                                <td class="text-end">

                                    <a asp-action="Details"
                                       asp-route-id="@item.ProductID"
                                       class="btn btn-sm btn-outline-primary"
                                       title="View Details">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.ProductID"
                                       class="btn btn-sm btn-warning">

                                        <i class="bi bi-pencil"></i>
                                        Edit

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.ProductID"
                                       class="btn btn-sm btn-danger">

                                        <i class="bi bi-trash"></i>
                                        Delete

                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="6"
                                class="text-center py-5">

                                <i class="bi bi-box-seam"
                                   style="font-size: 40px;">
                                </i>

                                <h5 class="mt-3">
                                    No Products Found
                                </h5>

                                <p class="text-muted">
                                    Try changing your search or filters.
                                </p>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>


    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="card-footer">

            <nav>

                <ul class="pagination justify-content-center mb-0">

                    <!-- Previous -->
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pageNumber="@(ViewBag.CurrentPage - 1)"
                           asp-route-searchString="@ViewData["CurrentFilter"]"
                           asp-route-categoryId="@ViewData["CurrentCategory"]"
                           asp-route-status="@ViewData["CurrentStatus"]">

                            <i class="bi bi-chevron-left"></i>

                        </a>

                    </li>


                    <!-- Pages -->
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pageNumber="@i"
                               asp-route-searchString="@ViewData["CurrentFilter"]"
                               asp-route-categoryId="@ViewData["CurrentCategory"]"
                               asp-route-status="@ViewData["CurrentStatus"]">

                                @i

                            </a>

                        </li>
                    }


                    <!-- Next -->
                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pageNumber="@(ViewBag.CurrentPage + 1)"
                           asp-route-searchString="@ViewData["CurrentFilter"]"
                           asp-route-categoryId="@ViewData["CurrentCategory"]"
                           asp-route-status="@ViewData["CurrentStatus"]">

                            <i class="bi bi-chevron-right"></i>

                        </a>

                    </li>

                </ul>

            </nav>

        </div>
    }

</div>