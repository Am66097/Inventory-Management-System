@model IEnumerable<WebApplication1.Models.Supplier>

@{
    ViewData["Title"] = "Suppliers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Suppliers</h2>
        <p class="text-muted mb-0">
            Manage your suppliers and their contact information
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i>
        Add New Supplier
    </a>
</div>


<!-- Search -->
<div class="card mb-4">
    <div class="card-body">

        <form asp-action="Index" method="get">

            <div class="row g-3 align-items-end">

                <div class="col-md-10">

                    <label class="form-label">
                        Search Suppliers
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               name="searchString"
                               value="@ViewData["CurrentFilter"]"
                               class="form-control"
                               placeholder="Search by supplier name, contact, phone or email..." />

                    </div>

                </div>

                <div class="col-md-2">

                    <button type="submit"
                            class="btn btn-primary w-100">

                        <i class="bi bi-search"></i>
                        Search

                    </button>

                </div>

            </div>

        </form>

    </div>
</div>


<!-- Suppliers Table -->
<div class="card">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead>

                    <tr>

                        <th>ID</th>

                        <th>Supplier Name</th>

                        <th>Contact Name</th>

                        <th>Phone</th>

                        <th>Email</th>

                        <th class="text-end">
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <span class="text-muted">
                                        #@item.SupplierId
                                    </span>
                                </td>

                                <td>
                                    <strong>
                                        @item.SupplierName
                                    </strong>
                                </td>

                                <td>
                                    @item.ContactName
                                </td>

                                <td>
                                    <i class="bi bi-telephone me-1"></i>
                                    @item.Phone
                                </td>

                                <td>
                                    <i class="bi bi-envelope me-1"></i>
                                    @item.Email
                                </td>

                                <td class="text-end">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.SupplierId"
                                       class="btn btn-sm btn-warning"
                                       title="Edit Supplier">

                                        <i class="bi bi-pencil"></i>
                                        Edit

                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@item.SupplierId"
                                       class="btn btn-sm btn-outline-primary"
                                       title="View Details">

                                        <i class="bi bi-eye"></i>
                                        Details

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.SupplierId"
                                       class="btn btn-sm btn-danger"
                                       title="Delete Supplier">

                                        <i class="bi bi-trash"></i>
                                        Delete

                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="6"
                                class="text-center py-5">

                                <i class="bi bi-building"
                                   style="font-size: 40px;">
                                </i>

                                <h5 class="mt-3">
                                    No Suppliers Found
                                </h5>

                                <p class="text-muted mb-0">
                                    Try another search or add a new supplier.
                                </p>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>