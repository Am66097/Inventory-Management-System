@model WebApplication1.Models.PurchaseItem

@{
    ViewData["Title"] = "Purchase Item Details";
}

<h2>Purchase Item Details</h2>
<hr />

<div class="card shadow-sm col-md-8">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Purchase Item ID</dt>
            <dd class="col-sm-8">@Model.PurchaseItemID</dd>

            <dt class="col-sm-4">Purchase ID</dt>
            <dd class="col-sm-8">@Model.PurchaseID</dd>

            <dt class="col-sm-4">Supplier</dt>
            <dd class="col-sm-8">@Model.Purchase?.Supplier?.SupplierName</dd>

            <dt class="col-sm-4">Product Name</dt>
            <dd class="col-sm-8">@Model.Product?.ProductName</dd>

            <dt class="col-sm-4">Quantity</dt>
            <dd class="col-sm-8">@Model.Quantity</dd>

            <dt class="col-sm-4">Unit Cost</dt>
            <dd class="col-sm-8">@Model.UnitCost.ToString("C")</dd>

            <dt class="col-sm-4">Subtotal</dt>
            <dd class="col-sm-8"><strong>@((Model.Quantity * Model.UnitCost).ToString("C"))</strong></dd>
        </dl>
    </div>
</div>

<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model.PurchaseItemID" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
