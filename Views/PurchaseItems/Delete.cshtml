@model WebApplication1.Models.PurchaseItem

@{
    ViewData["Title"] = "Delete Purchase Item";
}

<h2>Delete Purchase Item</h2>
<h4 class="text-danger">Are you sure you want to delete this purchase item?</h4>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-3">Item ID</dt>
        <dd class="col-sm-9">@Model.PurchaseItemID</dd>

        <dt class="col-sm-3">Purchase ID</dt>
        <dd class="col-sm-9">@Model.PurchaseID</dd>

        <dt class="col-sm-3">Supplier</dt>
        <dd class="col-sm-9">@Model.Purchase?.Supplier?.SupplierName</dd>

        <dt class="col-sm-3">Product</dt>
        <dd class="col-sm-9">@Model.Product?.ProductName</dd>

        <dt class="col-sm-3">Quantity</dt>
        <dd class="col-sm-9">@Model.Quantity</dd>

        <dt class="col-sm-3">Unit Cost</dt>
        <dd class="col-sm-9">@Model.UnitCost.ToString("C")</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="PurchaseItemID" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
