@model IEnumerable<WebApplication1.Models.PurchaseItem>

@{
    ViewData["Title"] = "Purchase Items";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Purchase Items List</h2>
    <a asp-action="Create" class="btn btn-primary">Add Item to Purchase</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Item ID</th>
            <th>Purchase ID</th>
            <th>Supplier</th>
            <th>Product</th>
            <th>Quantity</th>
            <th>Unit Cost</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.PurchaseItemID</td>
                    <td>@item.PurchaseID</td>
                    <td>@item.Purchase?.Supplier?.SupplierName</td>
                    <td>@item.Product?.ProductName</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitCost.ToString("C")</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.PurchaseItemID" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.PurchaseItemID" class="btn btn-sm btn-info">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.PurchaseItemID" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center text-muted">No purchase items found.</td>
            </tr>
        }
    </tbody>
</table>
