@model IEnumerable<WebApplication1.Models.Purchase>

@{
    ViewData["Title"] = "Purchases";
}

<h2>Purchases List</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Purchase</a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Purchase ID</th>
            <th>Supplier Name</th>
            <th>Purchase Date</th>
            <th>Total Amount</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.PurchaseID</td>
                <td>@(item.Supplier?.SupplierName ?? "N/A")</td>
                <td>@item.PurchaseDate.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@item.TotalAmount.ToString("C")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.PurchaseID" class="btn btn-sm btn-warning">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.PurchaseID" class="btn btn-sm btn-info">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.PurchaseID" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
