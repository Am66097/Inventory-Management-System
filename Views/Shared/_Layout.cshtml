@inject WebApplication1.Data.ApplicationDbContext _context
@{
    string currentUserName = Context.Request.Cookies["UserName"] ?? "Admin";
    string currentUserEmail = Context.Request.Cookies["UserEmail"] ?? "admin@stockora.com";
    string currentUserAvatar = Context.Request.Cookies["UserAvatar"] ?? "";

    int lowStockCount = _context.Products.Count(p => p.StockQuantity <= p.LowStockThreshold);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - STOCKORA</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            /* خلفية المستودع الذكي الهادئة والراقية الموحدة لكل الصفحات */
            body {
                background-color: #0b111e;
                background-image: linear-gradient(rgba(11, 17, 30, 0.90), rgba(11, 17, 30, 0.94)), radial-gradient(circle at 85% 15%, rgba(67, 56, 202, 0.22), transparent 45%), radial-gradient(circle at 10% 75%, rgba(16, 185, 129, 0.12), transparent 40%), url('https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?q=80&w=1920&auto=format&fit=crop');
                background-size: cover;
                background-position: center;
                background-attachment: fixed;
                background-repeat: no-repeat;
                color: #ffffff;
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                min-height: 100vh;
            }

            /* توحيد مظهر القائمة الجانبية والشريط العلوي مع الخلفية */
            .sidebar {
                background: rgba(16, 22, 34, 0.78) !important;
                backdrop-filter: blur(14px) !important;
                border-right: 1px solid rgba(255, 255, 255, 0.08) !important;
            }

            .topbar {
                background: rgba(16, 22, 34, 0.70) !important;
                backdrop-filter: blur(14px) !important;
                border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
            }

            /* كروت الجداول والمحتوى الداخلي بأسلوب زجاجي داكن وأنيق */
            .card, .table-responsive, .dashboard-card {
                background: rgba(22, 27, 38, 0.75) !important;
                backdrop-filter: blur(12px) !important;
                border: 1px solid rgba(255, 255, 255, 0.07) !important;
                border-radius: 16px !important;
            }

            .dropdown-menu-dark-custom {
                background-color: #161b26 !important;
                border: 1px solid rgba(255, 255, 255, 0.12) !important;
                border-radius: 14px !important;
                box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6) !important;
                padding: 10px !important;
            }

                .dropdown-menu-dark-custom .dropdown-item {
                    color: #cbd5e1 !important;
                    border-radius: 8px !important;
                    padding: 8px 14px !important;
                    font-size: 13.5px !important;
                    transition: all 0.2s ease;
                }

                    .dropdown-menu-dark-custom .dropdown-item:hover {
                        background-color: rgba(99, 102, 241, 0.15) !important;
                        color: #ffffff !important;
                    }

            .modal-content-custom {
                background: #161b26;
                border: 1px solid rgba(255, 255, 255, 0.12);
                border-radius: 20px;
                box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7);
                color: #ffffff;
            }
    </style>
</head>
<body>

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <a asp-controller="Home" asp-action="Index" class="brand text-decoration-none">
            <div class="brand-icon">
                <i class="bi bi-box-seam"></i>
            </div>
            <span>STOCKORA</span>
        </a>

        <div class="sidebar-section">
            <small>OVERVIEW</small>
            <a asp-controller="Home" asp-action="Dashboard" class="sidebar-link">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Dashboard</span>
            </a>
        </div>

        <div class="sidebar-section">
            <small>MANAGEMENT</small>
            <a asp-controller="Products" asp-action="Index" class="sidebar-link">
                <i class="bi bi-box"></i>
                <span>Products</span>
            </a>
            <a asp-controller="Categories" asp-action="Index" class="sidebar-link">
                <i class="bi bi-tags"></i>
                <span>Categories</span>
            </a>
            <a asp-controller="Suppliers" asp-action="Index" class="sidebar-link">
                <i class="bi bi-truck"></i>
                <span>Suppliers</span>
            </a>
            <a asp-controller="SupplierProducts" asp-action="Index" class="sidebar-link">
                <i class="bi bi-diagram-3"></i>
                <span>Supplier Contracts</span>
            </a>
        </div>

        <div class="sidebar-section">
            <small>OPERATIONS</small>
            <a asp-controller="Purchases" asp-action="Index" class="sidebar-link">
                <i class="bi bi-cart-plus"></i>
                <span>Purchases</span>
            </a>
            <a asp-controller="Sales" asp-action="Index" class="sidebar-link">
                <i class="bi bi-receipt"></i>
                <span>Sales</span>
            </a>
        </div>

        <div class="sidebar-section">
            <small>ANALYTICS</small>
            <a asp-controller="Home" asp-action="Analytics" class="sidebar-link">
                <i class="bi bi-bar-chart-line"></i>
                <span>Analytics</span>
            </a>
            <a asp-controller="Home" asp-action="Reports" class="sidebar-link">
                <i class="bi bi-file-earmark-bar-graph"></i>
                <span>Reports</span>
            </a>
        </div>

        <!-- أسفل السايدبار -->
        <div class="sidebar-bottom">
            <a asp-controller="Home" asp-action="Settings" class="sidebar-link">
                <i class="bi bi-gear"></i>
                <span>Settings</span>
            </a>
            <a asp-controller="Home" asp-action="Help" class="sidebar-link">
                <i class="bi bi-question-circle"></i>
                <span>Help Center</span>
            </a>

            <a asp-controller="Home" asp-action="Settings" class="sidebar-user text-decoration-none">
                <div class="sidebar-user-avatar d-flex align-items-center justify-content-center overflow-hidden" style="width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, #4f46e5, #6366f1);">
                    @if (!string.IsNullOrEmpty(currentUserAvatar))
                    {
                        <img src="@currentUserAvatar" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover;" />
                    }
                    else
                    {
                        <span class="text-white fw-bold">@currentUserName[0]</span>
                    }
                </div>
                <div>
                    <strong class="text-white">@currentUserName</strong>
                    <span class="text-secondary small">Administrator</span>
                </div>
            </a>
        </div>

    </aside>

    <!-- MAIN WRAPPER -->
    <div class="main-wrapper">

        <!-- TOPBAR -->
        <header class="topbar">

            <div class="topbar-title">
                <span class="topbar-label">INVENTORY SYSTEM</span>
                <h6>Inventory Management</h6>
                <small>Smart control for your business</small>
            </div>

            <div class="topbar-right d-flex align-items-center gap-3">

                <form asp-controller="Home" asp-action="GlobalSearch" method="get" class="topbar-search m-0">
                    <i class="bi bi-search"></i>
                    <input type="text" name="query" placeholder="Search pages, products & press Enter..." autocomplete="off" />
                </form>

                <!-- الإشعارات -->
                <div class="dropdown">
                    <button type="button" class="topbar-icon" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
                        <i class="bi bi-bell"></i>
                        @if (lowStockCount > 0)
                        {
                            <span class="notification-dot"></span>
                        }
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark-custom" style="width: 290px;">
                        <li class="px-3 py-2 border-bottom border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-white small">Notifications</span>
                            <span class="badge bg-danger">@lowStockCount New</span>
                        </li>
                        @if (lowStockCount > 0)
                        {
                            <li>
                                <a asp-controller="Home" asp-action="Reports" class="dropdown-item py-2">
                                    <div class="text-danger fw-bold small">⚠️ Low-Stock Alert</div>
                                    <div class="text-secondary" style="font-size: 12px;">@lowStockCount product(s) below threshold level!</div>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="px-3 py-3 text-center text-secondary small">
                                ✨ All products are healthy! No pending alerts.
                            </li>
                        }
                        <li class="border-top border-secondary border-opacity-25 mt-1 pt-1 text-center">
                            <a asp-controller="Home" asp-action="Reports" class="dropdown-item small text-primary fw-semibold text-center">
                                View Full Report →
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- بروفايل المستخدم -->
                <div class="dropdown">
                    <div class="profile-menu cursor-pointer" data-bs-toggle="dropdown" aria-expanded="false" style="cursor: pointer;">
                        <div class="profile-image d-flex align-items-center justify-content-center overflow-hidden" style="background: linear-gradient(135deg, #4f46e5, #6366f1); border-radius: 50%; width: 38px; height: 38px;">
                            @if (!string.IsNullOrEmpty(currentUserAvatar))
                            {
                                <img src="@currentUserAvatar" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                <span class="text-white fw-bold">@currentUserName[0]</span>
                            }
                        </div>
                        <div class="profile-info">
                            <strong class="text-white">@currentUserName</strong>
                            <span class="text-secondary" style="font-size: 11px;">@currentUserEmail</span>
                        </div>
                        <i class="bi bi-chevron-down profile-arrow text-secondary"></i>
                    </div>

                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark-custom" style="min-width: 210px;">
                        <li class="px-3 py-2 border-bottom border-secondary border-opacity-25">
                            <div class="fw-bold text-white small">@currentUserName</div>
                            <div class="text-secondary small" style="font-size: 11px;">@currentUserEmail</div>
                        </li>
                        <li>
                            <a asp-controller="Home" asp-action="Settings" class="dropdown-item">
                                <i class="bi bi-person-gear me-2 text-primary"></i> Account Settings
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Home" asp-action="Help" class="dropdown-item">
                                <i class="bi bi-question-circle me-2 text-info"></i> Help & Support
                            </a>
                        </li>
                        <li class="border-top border-secondary border-opacity-25 my-1"></li>
                        <li>
                            <a href="javascript:void(0)" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#logoutConfirmModal">
                                <i class="bi bi-box-arrow-right me-2 text-danger"></i> Sign Out
                            </a>
                        </li>
                    </ul>
                </div>

                <button type="button" class="logout-button border-0 bg-transparent" data-bs-toggle="modal" data-bs-target="#logoutConfirmModal">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Sign Out</span>
                </button>

            </div>

        </header>

        <!-- المحتوى والرسائل -->
        <main class="content position-relative">
            @if (TempData["SearchError"] != null)
            {
                <div class="alert alert-dismissible fade show text-white mb-4 d-flex align-items-center justify-content-between"
                     style="background: rgba(239, 68, 68, 0.18); border: 1px solid rgba(239, 68, 68, 0.4); border-radius: 14px; backdrop-filter: blur(10px);">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-octagon-fill text-danger fs-5"></i>
                        <span class="fw-semibold">@TempData["SearchError"]</span>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </main>

    </div>

    <!-- نافذة تأكيد الخروج -->
    <div class="modal fade" id="logoutConfirmModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-content-custom p-3 text-center">
                <div class="modal-body py-4">
                    <div class="mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; border-radius: 50%; background: rgba(239, 68, 68, 0.15); color: #ef4444; font-size: 28px;">
                        <i class="bi bi-box-arrow-right"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Sign Out Confirmation</h5>
                    <p class="text-secondary small mb-4">
                        Are you sure you want to sign out from <strong>Stockora</strong>?<br>
                        Your account and data remain safe. You can sign back in anytime.
                    </p>
                    <div class="d-flex justify-content-center gap-2">
                        <button type="button" class="btn btn-outline-secondary px-4 py-2 rounded-3" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <a asp-controller="Account" asp-action="Logout" class="btn btn-danger px-4 py-2 rounded-3 fw-semibold" style="background: #ef4444; border: none; box-shadow: 0 4px 15px rgba(239,68,68,0.4);">
                            Yes, Sign Out
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>