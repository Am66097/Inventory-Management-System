@model WebApplication1.Models.SupplierProduct

@{
    ViewData["Title"] = "Create Supplier Contract";
}
<style>
    .chat-message-bubble {
        line-height: 1.8 !important;
        word-break: break-word !important;
        white-space: pre-wrap !important;
        display: inline-block;
        max-width: 90%;
        text-align: right; /* عشان الكلام العربي يظهر من اليمين */
    }
</style>
<h2>Create Supplier Contract</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="SupplierID" class="form-label">Supplier</label>
                <select asp-for="SupplierID" class="form-select" asp-items="ViewBag.SupplierID">
                    <option value="">-- Select Supplier --</option>
                </select>
                <span asp-validation-for="SupplierID" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ProductID" class="form-label">Product</label>
                <select asp-for="ProductID" class="form-select" asp-items="ViewBag.ProductID">
                    <option value="">-- Select Product --</option>
                </select>
                <span asp-validation-for="ProductID" class="text-danger"></span>
            </div>

            <!-- الحقل المضاف: Supplier SKU -->
            <div class="mb-3">
                <label asp-for="SupplierSKU" class="form-label">Supplier SKU</label>
                <input asp-for="SupplierSKU" class="form-control" placeholder="Enter SKU" />
                <span asp-validation-for="SupplierSKU" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ContractPrice" class="form-label">Contract Price</label>
                <input asp-for="ContractPrice" type="number" step="0.01" class="form-control" placeholder="0.00" />
                <span asp-validation-for="ContractPrice" class="text-danger"></span>
            </div>

            <!-- الحقل المضاف: Contract Quantity -->
            <div class="mb-3">
                <label asp-for="ContractQuantity" class="form-label">Contract Quantity</label>
                <input asp-for="ContractQuantity" type="number" class="form-control" placeholder="0" />
                <span asp-validation-for="ContractQuantity" class="text-danger"></span>
            </div>

            <!-- الحقل المضاف: Lead Time Days -->
            <div class="mb-3">
                <label asp-for="LeadTimeDays" class="form-label">Lead Time Days</label>
                <input asp-for="LeadTimeDays" type="number" class="form-control" placeholder="e.g. 7" />
                <span asp-validation-for="LeadTimeDays" class="text-danger"></span>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> Save Contract</button>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

<script>
    document.getElementById("btnSend").addEventListener("click", async function () {
        let input = document.getElementById("userInput");
        let message = input.value.trim();
        if (!message) return;

        let chatBox = document.getElementById("chatBox");

        // عرض رسالة اليوزر (تم إضافة الكلاس هنا)
        chatBox.innerHTML += `<div class="text-end mb-2"><span class="bg-primary text-white p-2 rounded chat-message-bubble">User: ${message}</span></div>`;
        input.value = "";
        chatBox.scrollTop = chatBox.scrollHeight;

        // إرسال الطلب للـ Controller
        try {
            let response = await fetch('/Home/AskAiAssistant', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(message)
            });

            if (response.ok) {
                let data = await response.json();
                // عرض رد الذكاء الاصطناعي (تم إضافة الكلاس هنا)
                chatBox.innerHTML += `<div class="text-start mb-2"><span class="bg-info text-dark p-2 rounded chat-message-bubble">AI: ${data.reply}</span></div>`;
            } else {
                chatBox.innerHTML += `<div class="text-start mb-2 text-danger">Error connecting to AI.</div>`;
            }
        } catch (err) {
            chatBox.innerHTML += `<div class="text-start mb-2 text-danger">Network Error.</div>`;
        }

        chatBox.scrollTop = chatBox.scrollHeight;
    });
</script>
}